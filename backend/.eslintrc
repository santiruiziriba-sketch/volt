{
  "env": {
    "es2021": true,
    "node": true,
  },
  "extends": ["airbnb-base"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
  },
  "rules": {
    "no-console": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_id"],
      },
    ],
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "always",
      },
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
      },
    ],
  },
}
